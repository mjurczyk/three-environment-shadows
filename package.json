{
  "name": "three-environment-shadows",
  "version": "2.1.0",
  "description": "Soft, colored shadows from HDR / EXR / UltraHDR environment maps in Three.js (WebGL and WebGPU).",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./webgpu": {
      "types": "./webgpu.d.ts",
      "import": "./webgpu.js"
    }
  },
  "sideEffects": false,
  "files": [
    "*.js",
    "*.d.ts",
    "xatlas-web.wasm",
    "README.md"
  ],
  "keywords": [
    "threejs",
    "three",
    "shadows",
    "environment",
    "envmap",
    "hdr",
    "ibl",
    "lighting",
    "webgl",
    "webgpu",
    "tsl",
    "lightmap"
  ],
  "scripts": {
    "build": "rollup --config ./rollup.config.mjs && cd build && npm pack",
    "build:examples": "cd examples && npm run build",
    "dev": "cd examples && npm run dev",
    "format": "prettier --write src test types",
    "test": "vitest run && tsc",
    "test:build": "TEST_BUILD=1 vitest run",
    "test:visual": "node test/visual/run.mjs",
    "release": "npm run build && npm run test:build && cd ./build && npm publish"
  },
  "author": {
    "name": "mjurczyk",
    "url": "https://discourse.threejs.org/u/mjurczyk"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjurczyk/three-environment-shadows.git"
  },
  "peerDependencies": {
    "three": ">=0.162.0"
  },
  "devDependencies": {
    "@lopatnov/rollup-plugin-uglify": "^2.1.5",
    "@types/three": "^0.187.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.0",
    "puppeteer-core": "^24.43.1",
    "rollup": "^2.79.1",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "terser": "^5.36.0",
    "three": "^0.187.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "xatlas-web": "^0.1.0"
  }
}
